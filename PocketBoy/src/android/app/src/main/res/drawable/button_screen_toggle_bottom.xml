<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pb3ds_accent_purple" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/pb3ds_accent_purple" />
        </shape>
    </item>

    <!-- Selected State -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pb3ds_accent_purple" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/pb3ds_accent_purple" />
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pb3ds_tile_background" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/pb3ds_tile_border" />
        </shape>
    </item>
</selector>
